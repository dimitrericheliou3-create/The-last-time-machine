VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional auth email redirect override. Normally leave unset.
# Localhost automatically redirects to the live Pages site by default.
# Set to http://localhost:3000 only when deliberately testing local auth flows.
# VITE_AUTH_REDIRECT_URL=

# These are SERVER-SIDE Supabase Edge Function secrets; do not add them to VITE_* variables.
# Configure with: supabase secrets set HANDYPAY_API_KEY=... HANDYPAY_WEBHOOK_SECRET=... APP_URL=https://YOUR-PROJECT.pages.dev
# Supabase automatically provides SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY to Edge Functions.
